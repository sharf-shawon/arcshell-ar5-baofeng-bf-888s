{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Jekyll: Serve",
            "type": "shell",
            "command": "bundle exec jekyll serve --livereload --baseurl \"\"",
            "windows": {
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Bundle: Install",
            "type": "shell",
            "command": "bundle install",
            "windows": {
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": ["-NoProfile", "-Command"]
                    }
                }
            },
            "problemMatcher": []
        }
    ]
}
